    "mode.ramp.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تزداد السرعة كل دقيقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতি মিনিটে গতি বাড়ে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tempo speeds up every minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tempo acelera cada minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tempo accélère chaque minute."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर मिनट गति बढ़ती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo bertambah setiap menit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O andamento acelera a cada minuto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Темп растёт каждую минуту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر منٹ رفتار بڑھتی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每分钟加快一次。"
          }
        }
      }
